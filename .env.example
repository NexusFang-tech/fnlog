# FNLog — Environment Configuration
# Copy this file to .env and fill in your values

# Your Fortnite-API.com API key (free at https://fortnite-api.com)
FNLOG_API_KEY=your_api_key_here

# Your Epic Games display name (exact, case-sensitive)
FNLOG_EPIC_NAME=mskeith

# Optional: custom DB path (default: ~/.fnlog/sessions.db)
# FNLOG_DB_PATH=C:\Users\YourName\.fnlog\sessions.db

# Optional: web dashboard port (default: 7420)
# FNLOG_WEB_PORT=7420

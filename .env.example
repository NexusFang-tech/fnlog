# FNLog — Environment Configuration
# Copy this file to .env and fill in your values

# Your Fortnite-API.com API key (free at https://fortnite-api.com)
FNLOG_API_KEY=your_api_key_here

# Your Epic Games display name (exact, case-sensitive)
FNLOG_EPIC_NAME=YourEpicName

# Current season tag — update each new season (e.g. Ch6S2, Ch6S3)
FNLOG_SEASON=Ch6S2

# Discord webhook URL for session end notifications (optional)
# Create one in your server: Server Settings → Integrations → Webhooks
FNLOG_DISCORD_WEBHOOK=

# Optional overrides
# FNLOG_DB_PATH=C:\Users\YourName\.fnlog\sessions.db
# FNLOG_WEB_PORT=7420
